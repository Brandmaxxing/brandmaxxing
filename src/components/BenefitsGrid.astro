---
import { benefits } from '../data/benefits';
---

<ul class="benefits grid grid--4">
  {
    benefits.map((b) => (
      <li class="benefit reveal">
        <h3>{b.title}</h3>
        <p class="muted">{b.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .benefits {
    list-style: none;
    padding: 0;
  }

  .benefit {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-strong);
  }

  .benefit h3 {
    position: relative;
    font-size: var(--step-1);
  }

  .benefit h3::before {
    content: '';
    position: absolute;
    top: calc(-1.25rem - 1px);
    left: 0;
    width: 2.5rem;
    height: 1px;
    background: var(--accent);
  }

  .benefit p {
    font-size: 0.95rem;
  }
</style>
