---
import { roadmap } from '../data/roadmap';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<ol class:list={['roadmap', { 'roadmap--compact': compact }]}>
  {
    roadmap.map((phase) => (
      <li class="roadmap__phase reveal">
        <span class="roadmap__dot" aria-hidden="true">
          {phase.step}
        </span>
        <div class="roadmap__body">
          <p class="roadmap__name">{phase.name}</p>
          {!compact && <h3>{phase.headline}</h3>}
          <p class="muted">{phase.text}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .roadmap {
    position: relative;
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
    list-style: none;
    padding: 0;
  }

  /* Vertical gold line connecting the phases */
  .roadmap::before {
    content: '';
    position: absolute;
    left: 1.375rem;
    top: 1rem;
    bottom: 1rem;
    width: 1px;
    background: linear-gradient(var(--accent), rgba(200, 169, 106, 0.1));
  }

  .roadmap__phase {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
  }

  .roadmap__dot {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--accent);
  }

  .roadmap__body {
    display: grid;
    gap: 0.5rem;
    padding-top: 0.35rem;
    max-width: 40rem;
  }

  .roadmap__name {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* Compact: 3-up grid on mid-size screens, horizontal 6-up on wide screens */
  @media (min-width: 640px) and (max-width: 1099px) {
    .roadmap--compact {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem 1.5rem;
    }

    .roadmap--compact::before {
      display: none;
    }

    .roadmap--compact .roadmap__phase {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .roadmap--compact .roadmap__body {
      padding-top: 0;
    }
  }

  @media (min-width: 1100px) {
    .roadmap--compact {
      grid-template-columns: repeat(6, 1fr);
      gap: 1.5rem;
    }

    .roadmap--compact::before {
      left: 1.375rem;
      right: 1.375rem;
      top: 1.375rem;
      bottom: auto;
      width: auto;
      height: 1px;
      background: linear-gradient(90deg, var(--accent), rgba(200, 169, 106, 0.1));
    }

    .roadmap--compact .roadmap__phase {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .roadmap--compact .roadmap__body {
      padding-top: 0;
    }

    .roadmap--compact .muted {
      font-size: 0.92rem;
    }
  }
</style>
