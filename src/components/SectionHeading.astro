---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
}
const { eyebrow, title, intro, align = 'left', as: Tag = 'h2' } = Astro.props;
---

<header class:list={['section-heading', `section-heading--${align}`, 'reveal']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag set:html={title} />
  {intro && <p class="lead">{intro}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
    margin-bottom: clamp(2.25rem, 1.5rem + 2.5vw, 3.75rem);
  }

  .section-heading--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .section-heading--center .lead {
    margin-inline: auto;
  }
</style>
