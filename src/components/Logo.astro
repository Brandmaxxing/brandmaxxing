---
// Brand logo: the gold BXM mark (cut from brand/brandmaxxing-logo-original.jpg)
// plus a live-text BRANDMAXXING wordmark styled to echo the logo's gold serif.
interface Props {
  size?: 'sm' | 'md';
}
const { size = 'md' } = Astro.props;
---

<span class:list={['logo', `logo--${size}`]}>
  <img class="logo__mark" src="/logo-mark.webp" alt="" width="144" height="144" decoding="async" />
  <span class="logo__text">Brandmaxxing</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .logo__mark {
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
  }

  .logo__text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    background: linear-gradient(180deg, #f1d999 0%, var(--accent) 55%, #9c7a3e 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .logo--sm .logo__mark {
    width: 2.25rem;
    height: 2.25rem;
  }

  .logo--sm .logo__text {
    font-size: 0.95rem;
  }
</style>
