---
// Wordmark: a "maximise" double-chevron mark plus BRAND·MAXX·ING text.
// Swap this file out when a designed logo exists.
interface Props {
  size?: 'sm' | 'md';
}
const { size = 'md' } = Astro.props;
---

<span class:list={['logo', `logo--${size}`]}>
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true">
    <rect x="0.75" y="0.75" width="30.5" height="30.5" rx="7" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width="1.5"></rect>
    <path d="M9.5 17.5 16 11l6.5 6.5M9.5 23.5 16 17l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="logo__text">Brand<span class="logo__maxx">maxx</span>ing</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--accent);
  }

  .logo__mark {
    width: 1.9rem;
    height: 1.9rem;
    flex: none;
  }

  .logo__text {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text);
  }

  .logo__maxx {
    color: var(--accent);
  }

  .logo--sm .logo__mark {
    width: 1.6rem;
    height: 1.6rem;
  }

  .logo--sm .logo__text {
    font-size: 0.85rem;
  }
</style>
