---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PackageCard from '../components/PackageCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { packages } from '../data/packages';
import { specialistServices } from '../data/services';
import { faq } from '../data/faq';
---

<BaseLayout
  title="Packages"
  description="Brand Starter, Brand Builder and Brand Accelerator: three monthly marketing packages for small, growing and established South African businesses."
>
  <PageHero
    eyebrow="Packages"
    title="Three packages. <em class='accent'>Built around you.</em>"
    intro="Every package starts with a discovery consultation, so the work fits your business. Pick the level of support that suits where you are now."
  />

  <section class="section">
    <div class="container">
      <div class="grid grid--3 packages">
        {packages.map((p) => <PackageCard pkg={p} />)}
      </div>
      <p class="extras muted reveal">
        Not included in packages and quoted separately: {specialistServices.join(', ').toLowerCase()}.
      </p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container faq-wrap">
      <SectionHeading eyebrow="Questions" title="Good to know" />
      <div class="faq">
        {
          faq.map((item) => (
            <details class="faq__item reveal">
              <summary>{item.q}</summary>
              <p class="muted">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Not sure which package fits? <em class='accent'>Let’s talk.</em>"
    text="We’ll recommend a package once we understand your business and goals. No pressure, no obligation."
  />
</BaseLayout>

<style>
  .packages {
    padding-top: 0.75rem;
    align-items: stretch;
  }

  .extras {
    margin-top: 2.5rem;
    font-size: 0.93rem;
    text-align: center;
  }

  .faq-wrap {
    max-width: 52rem;
  }

  .faq {
    border-top: 1px solid var(--border-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--border-strong);
  }

  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.4rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: '+';
    flex: none;
    font-family: var(--font-body);
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--accent);
    transition: transform 0.3s var(--ease);
  }

  .faq__item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq__item p {
    padding-bottom: 1.5rem;
    max-width: 62ch;
  }
</style>
