---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="section not-found">
    <div class="container not-found__inner">
      <p class="not-found__code">404</p>
      <h1>This page has <em class="accent">gone unseen</em>.</h1>
      <p class="lead">The page you’re looking for doesn’t exist or has moved. Unlike your brand, it won’t be remembered.</p>
      <div class="not-found__actions">
        <Button href="/">Back to home</Button>
        <Button href="/contact/" variant="ghost">Contact us</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 70vh;
    display: grid;
    align-items: center;
  }

  .not-found__inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .not-found__inner .lead {
    margin-inline: auto;
  }

  .not-found__code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 3rem + 10vw, 10rem);
    font-style: italic;
    line-height: 1;
    color: var(--accent);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 0.75rem;
  }
</style>
