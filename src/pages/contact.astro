---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import BookingPlaceholder from '../components/BookingPlaceholder.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description="Book a free consultation or send Brandmaxxing an enquiry. Tell us about your business and we’ll show you where the opportunities are."
>
  <PageHero
    eyebrow="Contact"
    title="Tell us about <em class='accent'>your business</em>."
    intro="The more we know about what you do and where you want to go, the more useful our first conversation will be."
  />

  <section class="section">
    <div class="container contact">
      <div class="contact__form card reveal">
        <h2>Send an enquiry</h2>
        <EnquiryForm />
      </div>

      <aside class="contact__aside">
        <BookingPlaceholder />

        <div class="card contact__direct reveal">
          <p class="eyebrow">Prefer email?</p>
          <a class="contact__email" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          {
            site.contact.phone && (
              <a class="contact__phone" href={`tel:${site.contact.phone.replace(/\s/g, '')}`}>
                {site.contact.phone}
              </a>
            )
          }
          <p class="muted">We aim to reply within one business day.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 1rem + 2vw, 2.5rem);
    align-items: start;
  }

  .contact__form {
    display: grid;
    gap: 1.5rem;
  }

  .contact__form h2 {
    font-size: var(--step-2);
  }

  .contact__aside {
    display: grid;
    gap: clamp(1.25rem, 1rem + 2vw, 2.5rem);
  }

  .contact__direct {
    display: grid;
    gap: 0.75rem;
  }

  .contact__email,
  .contact__phone {
    font-family: var(--font-display);
    font-size: var(--step-1);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact__email:hover,
  .contact__phone:hover {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: 1fr;
    }

    /* Booking first on small screens: it's the quickest route in */
    .contact__aside {
      order: -1;
    }
  }
</style>
